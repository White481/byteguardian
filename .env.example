# Copy to .env:  cp .env.example .env

# Local dev uses SQLite (no install needed).
# To switch to PostgreSQL: change provider in prisma/schema.prisma to "postgresql"
# and set e.g. DATABASE_URL="postgresql://user:password@localhost:5432/byteguardian"
DATABASE_URL="file:./dev.db"

# Auth (owner: ตัง) — generate with: openssl rand -base64 32
AUTH_SECRET="change_me"

# OAuth (optional, only if credentials are provided)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ID=""
AUTH_MICROSOFT_SECRET=""

# AI service (from Data/AI team) — leave empty to use mock responses
# Local: run `uvicorn app:app --app-dir data-ai/service --port 8000`, then
# AI_API_URL="http://localhost:8000/insights" and AI_CHAT_URL="http://localhost:8000/chat"
AI_API_URL=""
AI_API_KEY=""
# AI assistant chat endpoint (from Data/AI team) — leave empty for mock replies
AI_CHAT_URL=""
